{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/pwa/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/pwa/:path*"
    }
  ],
  "headers": [
    {
      "source": "/pwa/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
